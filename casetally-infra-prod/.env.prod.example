# Domains (must resolve to your production server public IP)
TRAEFIK_DOMAIN=traefik.casetally.io
REGISTRY_DOMAIN=registry.casetally.io

# Traefik / Let's Encrypt
TRAEFIK_DOCKER_NETWORK=casetally-network
LETSENCRYPT_EMAIL=casetallybusiness@gmail.com

# Restrict dashboard + registry UI by source IP/CIDR
ADMIN_ALLOWLIST_CIDRS=203.0.113.10/32,198.51.100.0/24

# Basic auth hashes (htpasswd -nbm user "password")
# IMPORTANT: escape each "$" as "$$" in .env files for Docker Compose.
TRAEFIK_BASIC_AUTH=casetallyadmin:$$apr1$$replace$$replace
REGISTRY_BASIC_AUTH=casetallyregistry:$$apr1$$replace$$replace

# Base64 of "casetallyregistry:<plain-password>" (no trailing newline)
REGISTRY_PROXY_BASIC_AUTH_B64=b3BlbnJpZ2h0c3JlZ2lzdHJ5OkNIQU5HRV9NRQ==

# Registry behavior
REGISTRY_DELETE_ENABLED=false
REGISTRY_UI_DELETE_IMAGES=false

# Rate limit for registry API
REGISTRY_RATELIMIT_AVERAGE=100
REGISTRY_RATELIMIT_BURST=200

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Embedding worker
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
WORKER_BATCH_SIZE=100
WORKER_POLL_INTERVAL=5

# Search
SEARCH_EMBEDDING_ENABLED=true

# Groq LLM (free tier — get a key at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Reasoning-class models spend tokens before emitting content; set empty to
# omit the parameter for models that do not support it.
GROQ_REASONING_EFFORT=low
